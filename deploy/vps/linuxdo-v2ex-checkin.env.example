# ========================================
# linuxdo-v2ex-checkin VPS Example
# ========================================

# ----------------------------------------
# LinuxDo
# Recommended: keep cookie and username/password together.
# The script will try cookie first, then fall back to username/password,
# and write the refreshed LINUXDO_COOKIES back automatically.
# ----------------------------------------
LINUXDO_COOKIES=_t=your_cookie; _forum_session=your_session; cf_clearance=optional_if_present
# LINUXDO_USERNAME=your_username_or_email
# LINUXDO_PASSWORD=your_password

# Optional: custom env file path
# LINUXDO_ENV_FILE=/etc/linuxdo-v2ex-checkin.env

# Optional: set BROWSE_ENABLED=false only if you want to disable LinuxDo browsing
# BROWSE_ENABLED=false

# Shared YesCaptcha key for LinuxDo / NodeSeek password login
CLIENTT_KEY=your_yescaptcha_client_key

# LinuxDo now always tries cookie first, then falls back to username/password.
# On VPS, deploy/vps/run.sh will automatically use xvfb-run when DISPLAY is empty.
# hCaptcha wait budget = MAX_RETRIES * RETRY_INTERVAL
# LINUXDO_YESCAPTCHA_HCAPTCHA_MAX_RETRIES=15
# LINUXDO_YESCAPTCHA_HCAPTCHA_RETRY_INTERVAL=4
# LINUXDO_YESCAPTCHA_HCAPTCHA_TIMEOUT=90

# ----------------------------------------
# Auto update before each systemd run
# ----------------------------------------
AUTO_UPDATE=true
AUTO_INSTALL_DEPS=true
AUTO_UPDATE_STRICT=true

# ----------------------------------------
# V2EX
# Cookie only. You can provide the full cookie string or only A2.
# Success notification includes today's reward and current balance.
# ----------------------------------------
V2EX_ENABLED=true
# V2EX_COOKIE=A2=your_a2_cookie; PB3_SESSION=optional_if_present
# V2EX_A2=your_a2_cookie

# ----------------------------------------
# Xiaoheihe
# Cookie only. main.py will call the built-in Python signer flow directly.
# ----------------------------------------
# XIAOHEIHE_ENABLED=true
# XIAOHEIHE_KEY=chenjian
# XIAOHEIHE_ACCOUNT_NAME=main
# XIAOHEIHE_COOKIE=pkey=your_pkey; x_xhh_tokenid=your_token
# XIAOHEIHE_HEADERS_JSON={"x_client_type":"mobile"}
# XIAOHEIHE_TIMEOUT=20
# XIAOHEIHE_RETRY_TIMES=6
# XIAOHEIHE_RETRY_MIN_DELAY=3
# XIAOHEIHE_RETRY_MAX_DELAY=12
# XIAOHEIHE_IMPERSONATE=chrome136
# XIAOHEIHE_HEYBOX_ID=optional_if_pkey_cannot_be_parsed
# XIAOHEIHE_ANDROID_ID=493245af067c9e43
# XIAOHEIHE_DEVICE_MODEL=SM-S9210

# ----------------------------------------
# NodeSeek
# Shared settings for all NodeSeek accounts.
# Each account can use:
# 1. COOKIE only
# 2. USERNAME + PASSWORD only
# 3. COOKIE + USERNAME + PASSWORD together
#    -> try cookie first, then fall back to username/password automatically
# Success notification includes today's reward and current balance.
# ----------------------------------------
NODESEEK_ENABLED=true
NODESEEK_SOLVER_TYPE=yescaptcha
NODESEEK_RANDOM=true
NODESEEK_IMPERSONATE=chrome136

# Single-account example
# NODESEEK_NAME=main
# NODESEEK_COOKIE=nodepay_session=your_cookie
# NODESEEK_USERNAME=your_username
# NODESEEK_PASSWORD=your_password

# Two-account example
# Account 1: cookie + username/password fallback
# NODESEEK_NAME_1=main
# NODESEEK_COOKIE_1=nodepay_session=account1_cookie
# NODESEEK_USERNAME_1=account1_username
# NODESEEK_PASSWORD_1=account1_password

# Account 2: cookie + username/password fallback
# NODESEEK_NAME_2=backup
# NODESEEK_COOKIE_2=nodepay_session=account2_cookie
# NODESEEK_USERNAME_2=account2_username
# NODESEEK_PASSWORD_2=account2_password

# Optional per-account overrides
# NODESEEK_RANDOM_2=false
# NODESEEK_IMPERSONATE_2=chrome133a

# ----------------------------------------
# Notifications
# Configure only the channels you want.
# ----------------------------------------
NOTIFY_TIMEZONE=Asia/Shanghai

# Telegram
# TELEGRAM_BOT_TOKEN=123456:ABCDEF
# TELEGRAM_CHAT_ID=123456789

# Gotify
# GOTIFY_URL=https://your.gotify.server
# GOTIFY_TOKEN=your_token

# ServerChan3
# SC3_PUSH_KEY=sctxxxxxxxxxxxxxxxxxxxxxt

# wxpush
# WXPUSH_URL=https://your.wxpush.server
# WXPUSH_TOKEN=your_wxpush_token
